<projectSpec>
  <project
        name="c2000_fatfs_f2837xs"
        device="Generic C28xx Device"
        cgtVersion="21.6.0.LTS"
        products="C2000WARE"
        launchWizard="False"
        outputType="staticLibrary"
        outputFormat="ELF"
        >
    <configuration name="Debug" compilerBuildOptions="--opt_level=off -I${C2000WARE_DLIB_ROOT} -I${C2000WARE_DEV_SUPPORT} -I../ -v28 -ml -mt --float_support=fpu64  --abi=eabi --define=CPU1   --define=DEBUG -g --diag_warning=225 --diag_wrap=off  --gen_func_subsections=on --gen_data_subsections=on " archiverBuildOptions="fatfs.lib" />
    <configuration name="Release" compilerBuildOptions="-O2 -I${C2000WARE_DLIB_ROOT} -I${C2000WARE_DEV_SUPPORT} -I../ -v28 -ml -mt --float_support=fpu64  --define=CPU1 -g --diag_warning=225 --diag_wrap=off --display_error_number --gen_func_subsections=on --gen_data_subsections=on --abi=eabi" archiverBuildOptions="fatfs.lib" />

    <pathVariable name="C2000WARE_ROOT"      path="../../../" scope="project" />
    <pathVariable name="C2000WARE_DLIB_ROOT" path="../../../driverlib/f2837xs/driverlib" scope="project" />
    <pathVariable name="C2000WARE_DEV_SUPPORT" path="../../../device_support/f2837xs/common/include" scope="project" />

    <file action="copy" path="../fatfs/diskio.c"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/diskio.h"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/ff.c"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/ff.h"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/ffcio.c"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/ffcio.h"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/ffconf.h"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/ffunicode.c"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/integer.h"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/ramdisk.c"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/00history.txt"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/00readme.txt"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/TI_README.md"  targetDirectory="fatfs" excludeFromBuild="False" />
    <file action="copy" path="../fatfs/ffsystem.c"  targetDirectory="fatfs" excludeFromBuild="True" />
    <file action="copy" path="../fatfs/utils" targetDirectory="fatfs" excludeFromBuild="True" />

    <file action="copy" path="../sdspi/" targetDirectory="." excludeFromBuild="False" />
  </project>
</projectSpec>
